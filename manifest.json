{
  "manifest_version": 3,
  "name": "ABEMAコメント分析（非公式）",
  "version": "0.13.2",
  "description": "ABEMAのコメントを端末内に記録し、本文検索・投稿者タグ・リプレイ・ミュートができる非公式拡張機能です。",
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://abema.tv/*"
  ],
  "action": {
    "default_title": "ABEMAコメント分析（非公式）",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://abema.tv/*"
      ],
      "js": [
        "network-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://abema.tv/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://abema.tv/*"
      ],
      "js": [
        "comment-tools.js",
        "learning-model.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [],
  "options_page": "dashboard.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
